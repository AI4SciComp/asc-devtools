#!/usr/bin/env bash
# asc-devtools managed file

set -o errexit
set -o nounset
set -o pipefail

asc_resolve_script_path() {
  local source_path="$1"
  local directory
  local target
  while [[ -L "${source_path}" ]]; do
    directory=$(cd -P -- "$(dirname -- "${source_path}")" && pwd)
    target=$(readlink -- "${source_path}")
    [[ "${target}" == /* ]] && source_path="${target}" || source_path="${directory}/${target}"
  done
  directory=$(cd -P -- "$(dirname -- "${source_path}")" && pwd)
  printf '%s/%s\n' "${directory}" "$(basename -- "${source_path}")"
}

ASC_EXECUTABLE=$(asc_resolve_script_path "${BASH_SOURCE[0]}")
ASC_BIN_DIRECTORY=$(dirname -- "${ASC_EXECUTABLE}")
ASC_INSTALL_ROOT=$(cd -- "${ASC_BIN_DIRECTORY}/.." && pwd)
ASC_LIBRARY_DIRECTORY="${ASC_INSTALL_ROOT}/lib/asc"
[[ -f "${ASC_LIBRARY_DIRECTORY}/common.sh" ]] || {
  printf 'asc: error: libraries not found under %s\n' "${ASC_LIBRARY_DIRECTORY}" >&2
  exit 1
}

# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/common.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/json.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/config.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/process.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/github.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/repository.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/doctor.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/cmake.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/vendor.sh"
# shellcheck source=/dev/null
source "${ASC_LIBRARY_DIRECTORY}/update.sh"

asc_print_help() {
  cat <<'EOF'
Usage: asc [GLOBAL OPTIONS] COMMAND [ARGS]

Safely manage AI4SciComp repositories in one local workspace.

Commands:
  doctor [--json]                 Diagnose tools and GitHub access
  workspace                       Print the resolved workspace
  repo list [--json]              List organization repositories
  repo clone [NAME...]            Clone missing repositories
  repo status [NAME...] [--json]  Inspect local repositories
  repo sync [NAME...] [--dry-run] Download remote fast-forwards into clean repositories
  repo save NAME [--message TEXT] Commit local changes and push the tracked branch
  configure NAME --preset PRESET  Configure a CMake preset
  build NAME --preset PRESET      Build a CMake preset
  test NAME --preset PRESET       Run a CTest preset
  cmake COMMAND ...               CMake workflows and local vendoring
  update [--check] [--yes]        Update asc to the latest release
  completion bash                 Print Bash completion

Global options (must precede COMMAND):
  --config PATH
  --organization NAME
  --workspace PATH
  --no-color
  -h, --help
  --version
EOF
}

asc_repo_list() {
  local json_output="$1"
  local discovery
  local record name archived fork clone_url ssh_url default_branch private
  local first=true
  if ! discovery=$(asc_github_discover); then return 1; fi
  if [[ "${json_output}" == true ]]; then
    printf '[\n'
    while IFS= read -r record; do
      [[ -n "${record}" ]] || continue
      IFS=$'\t' read -r name archived fork clone_url ssh_url default_branch private <<<"${record}"
      [[ "${first}" == true ]] || printf ',\n'
      first=false
      printf '  {"name":%s,"archived":%s,"fork":%s,"clone_url":%s,"ssh_url":%s,"default_branch":%s,"private":%s}' \
        "$(asc_json_quote "${name}")" "${archived}" "${fork}" \
        "$(asc_json_quote "${clone_url}")" "$(asc_json_quote "${ssh_url}")" \
        "$(asc_json_quote "${default_branch}")" "${private}"
    done <<<"${discovery}"
    printf '\n]\n'
    return 0
  fi
  printf 'REPOSITORY\tVISIBILITY\tDEFAULT BRANCH\n'
  while IFS= read -r record; do
    [[ -n "${record}" ]] || continue
    IFS=$'\t' read -r name archived fork clone_url ssh_url default_branch private <<<"${record}"
    [[ "${private}" == true ]] && private=private || private=public
    printf '%s\t%s\t%s\n' "${name}" "${private}" "${default_branch}"
  done <<<"${discovery}"
}

asc_completion_bash() {
  local completion_path="${ASC_INSTALL_ROOT}/completions/asc.bash"
  [[ -f "${completion_path}" ]] || completion_path="${ASC_INSTALL_ROOT}/share/bash-completion/completions/asc"
  [[ -f "${completion_path}" ]] || {
    asc_error "Bash completion file not found"
    return 1
  }
  cat -- "${completion_path}"
}

asc_usage_error() {
  asc_error "$1"
  printf '\n' >&2
  asc_print_help >&2
  return 2
}

asc_run_cmake_operation() {
  local operation="$1"
  shift
  local repository="" preset="" label=""
  local output_on_failure=false
  local -a targets=() options=()
  while (($# > 0)); do
    case "$1" in
      --preset | --target | --label)
        (($# >= 2)) || {
          asc_usage_error "$1 requires a value"
          return
        }
        case "$1" in
          --preset) preset="$2" ;;
          --target)
            [[ "${operation}" == build ]] || {
              asc_usage_error "--target is valid only for cmake build"
              return
            }
            targets+=("$2")
            ;;
          --label)
            [[ "${operation}" == test ]] || {
              asc_usage_error "--label is valid only for cmake test"
              return
            }
            label="$2"
            ;;
        esac
        shift 2
        ;;
      --output-on-failure)
        [[ "${operation}" == test ]] || {
          asc_usage_error "--output-on-failure is valid only for cmake test"
          return
        }
        output_on_failure=true
        shift
        ;;
      -*)
        asc_usage_error "unknown cmake ${operation} option: $1"
        return
        ;;
      *)
        [[ -z "${repository}" ]] || {
          asc_usage_error "cmake ${operation} takes one repository"
          return
        }
        repository="$1"
        shift
        ;;
    esac
  done
  [[ -n "${repository}" && -n "${preset}" ]] || {
    asc_usage_error "repository and --preset are required"
    return
  }
  local target
  for target in "${targets[@]}"; do options+=(--target "${target}"); done
  [[ -z "${label}" ]] || options+=(--label "${label}")
  [[ "${output_on_failure}" != true ]] || options+=(--output-on-failure)
  asc_cmake_run "${operation}" "${repository}" "${preset}" "${options[@]}"
}

asc_run_cmake_vendor() {
  local vendor_command="${1:-}"
  (($# > 0)) && shift
  [[ -n "${vendor_command}" ]] || {
    asc_usage_error "a vendor command is required"
    return
  }
  if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
    printf 'Usage: asc cmake vendor %s REPOSITORY [OPTIONS]\n' "${vendor_command}"
    return 0
  fi
  local repository="" source_path="" requested_ref="" answer=""
  local json_output=false yes=false
  while (($# > 0)); do
    case "$1" in
      --source | --ref)
        (($# >= 2)) || {
          asc_usage_error "$1 requires a value"
          return
        }
        [[ "$1" == --source ]] && source_path="$2" || requested_ref="$2"
        shift 2
        ;;
      --json)
        json_output=true
        shift
        ;;
      --yes)
        yes=true
        shift
        ;;
      -*)
        asc_usage_error "unknown vendor ${vendor_command} option: $1"
        return
        ;;
      *)
        [[ -z "${repository}" ]] || {
          asc_usage_error "vendor ${vendor_command} takes one repository"
          return
        }
        repository="$1"
        shift
        ;;
    esac
  done
  [[ -n "${repository}" ]] || {
    asc_usage_error "vendor ${vendor_command} requires one repository"
    return
  }
  case "${vendor_command}" in
    status)
      [[ -z "${source_path}" && -z "${requested_ref}" && "${yes}" == false ]] || {
        asc_usage_error "vendor status accepts only --json"
        return
      }
      asc_vendor_status "${repository}" || return 1
      if [[ "${json_output}" == true ]]; then
        printf '{"repository":%s,"state":%s' \
          "$(asc_json_quote "${repository}")" "$(asc_json_quote "${ASC_VENDOR_STATUS_STATE}")"
        [[ -z "${ASC_VENDOR_MANIFEST_VERSION:-}" ]] || printf ',"version":%s' "$(asc_json_quote "${ASC_VENDOR_MANIFEST_VERSION}")"
        [[ -z "${ASC_VENDOR_MANIFEST_COMMIT:-}" ]] || printf ',"commit":%s' "$(asc_json_quote "${ASC_VENDOR_MANIFEST_COMMIT}")"
        if ((${#ASC_VENDOR_EXTRA_FILES[@]} > 0)); then
          printf ',"extraFiles":['
          local index
          for index in "${!ASC_VENDOR_EXTRA_FILES[@]}"; do
            ((index == 0)) || printf ','
            asc_json_quote "${ASC_VENDOR_EXTRA_FILES[index]}"
          done
          printf ']'
        fi
        [[ -z "${ASC_VENDOR_STATUS_DETAIL}" ]] || printf ',"detail":%s' "$(asc_json_quote "${ASC_VENDOR_STATUS_DETAIL}")"
        printf '}\n'
      else
        printf '%s: %s' "${repository}" "${ASC_VENDOR_STATUS_STATE}"
        [[ -z "${ASC_VENDOR_STATUS_DETAIL}" ]] || printf ': %s' "${ASC_VENDOR_STATUS_DETAIL}"
        printf '\n'
        local extra
        for extra in "${ASC_VENDOR_EXTRA_FILES[@]}"; do printf '  extra: %s\n' "${extra}"; done
      fi
      ;;
    plan | apply)
      if [[ "${vendor_command}" == plan && "${yes}" == true ]]; then
        asc_usage_error "--yes is valid only for vendor apply"
        return
      fi
      if [[ "${vendor_command}" == apply && "${json_output}" == true ]]; then
        asc_usage_error "--json is valid only for vendor plan"
        return
      fi
      asc_vendor_plan "${repository}" "${source_path}" "${requested_ref}" || return 1
      if [[ "${vendor_command}" == plan ]]; then
        if [[ "${json_output}" == true ]]; then
          asc_vendor_plan_json
        else
          asc_vendor_print_plan
        fi
        return 0
      fi
      local approved_fingerprint="${ASC_VENDOR_PLAN_FINGERPRINT}"
      if [[ "${yes}" != true ]]; then
        asc_vendor_print_plan >&2
        printf 'Apply this exact plan? [y/N] ' >&2
        IFS= read -r answer || true
        answer="${answer,,}"
        if [[ "${answer}" != y && "${answer}" != yes ]]; then
          printf 'asc: vendor apply cancelled\n' >&2
          return 1
        fi
      fi
      asc_vendor_plan "${repository}" "${source_path}" "${requested_ref}" || return 1
      [[ "${ASC_VENDOR_PLAN_FINGERPRINT}" == "${approved_fingerprint}" ]] || {
        asc_error "vendor plan changed during confirmation; run plan again"
        return 1
      }
      asc_vendor_source_load "${source_path}" "${ASC_VENDOR_SOURCE_COMMIT}" false || return 1
      asc_vendor_apply_current_plan || return 1
      asc_vendor_print_plan
      printf 'Applied vendored asc-cmake files. Review with: git diff -- %s\n' "${ASC_CMAKE_VENDOR_DIRECTORY}"
      ;;
    *)
      asc_usage_error "unknown vendor command: ${vendor_command}"
      return
      ;;
  esac
}

asc_run_cmake_group() {
  local cmake_command="${1:-}"
  (($# > 0)) && shift
  [[ -n "${cmake_command}" ]] || {
    asc_usage_error "a cmake command is required"
    return
  }
  if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
    printf 'Usage: asc cmake %s [OPTIONS]\n' "${cmake_command}"
    return 0
  fi
  case "${cmake_command}" in
    configure | build | test) asc_run_cmake_operation "${cmake_command}" "$@" ;;
    workflow)
      local repository="" configure_preset="" build_preset="" test_preset="" option
      while (($# > 0)); do
        case "$1" in
          --configure-preset | --build-preset | --test-preset)
            option="$1"
            (($# >= 2)) || {
              asc_usage_error "${option} requires a value"
              return
            }
            case "${option}" in
              --configure-preset) configure_preset="$2" ;;
              --build-preset) build_preset="$2" ;;
              --test-preset) test_preset="$2" ;;
            esac
            shift 2
            ;;
          -*)
            asc_usage_error "unknown cmake workflow option: $1"
            return
            ;;
          *)
            [[ -z "${repository}" ]] || {
              asc_usage_error "cmake workflow takes one repository"
              return
            }
            repository="$1"
            shift
            ;;
        esac
      done
      [[ -n "${repository}" && -n "${configure_preset}" && -n "${build_preset}" && -n "${test_preset}" ]] || {
        asc_usage_error "repository and all three workflow presets are required"
        return
      }
      asc_cmake_workflow "${repository}" "${configure_preset}" "${build_preset}" "${test_preset}"
      ;;
    presets)
      local repository="" json_output=false
      while (($# > 0)); do
        case "$1" in
          --json) json_output=true ;;
          -*)
            asc_usage_error "unknown cmake presets option: $1"
            return
            ;;
          *)
            [[ -z "${repository}" ]] || {
              asc_usage_error "cmake presets takes one repository"
              return
            }
            repository="$1"
            ;;
        esac
        shift
      done
      [[ -n "${repository}" ]] || {
        asc_usage_error "cmake presets requires one repository"
        return
      }
      asc_cmake_presets "${repository}" "${json_output}"
      ;;
    vendor) asc_run_cmake_vendor "$@" ;;
    *)
      asc_usage_error "unknown cmake command: ${cmake_command}"
      return
      ;;
  esac
}

asc_main() {
  local config_override="${ASC_OVERRIDE_UNSET}"
  local organization_override="${ASC_OVERRIDE_UNSET}"
  local workspace_override="${ASC_OVERRIDE_UNSET}"
  local command=""
  local option
  while (($# > 0)); do
    case "$1" in
      --config | --organization | --workspace)
        option="$1"
        (($# >= 2)) || {
          asc_usage_error "${option} requires a value"
          return
        }
        case "${option}" in
          --config) config_override="$2" ;;
          --organization) organization_override="$2" ;;
          --workspace) workspace_override="$2" ;;
        esac
        shift 2
        ;;
      --no-color) shift ;;
      -h | --help)
        asc_print_help
        return 0
        ;;
      --version)
        printf 'asc %s\n' "${ASC_VERSION}"
        return 0
        ;;
      --*)
        asc_usage_error "unknown global option: $1"
        return
        ;;
      *)
        command="$1"
        shift
        break
        ;;
    esac
  done
  [[ -n "${command}" ]] || {
    asc_usage_error "a command is required"
    return
  }

  if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
    case "${command}" in
      workspace) printf 'Usage: asc workspace\n' ;;
      doctor) printf 'Usage: asc doctor [--json]\n' ;;
      repo) printf 'Usage: asc repo {list|clone|status|sync|save} [OPTIONS] [REPOSITORY...]\n' ;;
      configure | build | test) printf 'Usage: asc %s REPOSITORY --preset PRESET\n' "${command}" ;;
      cmake) printf 'Usage: asc cmake {configure|build|test|workflow|presets|vendor} ...\n' ;;
      update) printf 'Usage: asc update [--check] [--yes] [--prefix PATH]\n' ;;
      completion) printf 'Usage: asc completion bash\n' ;;
      *)
        asc_usage_error "unknown command: ${command}"
        return
        ;;
    esac
    return 0
  fi

  asc_config_load "${config_override}" "${organization_override}" "${workspace_override}" || return 1
  case "${command}" in
    workspace)
      (($# == 0)) || {
        asc_usage_error "workspace takes no arguments"
        return
      }
      printf '%s\n' "${ASC_WORKSPACE}"
      ;;
    doctor)
      local doctor_json=false
      if (($# == 1)) && [[ "$1" == --json ]]; then
        doctor_json=true
      elif (($# != 0)); then
        asc_usage_error "doctor accepts only --json"
        return
      fi
      asc_doctor "${doctor_json}"
      ;;
    repo)
      (($# > 0)) || {
        asc_usage_error "a repo command is required"
        return
      }
      local repo_command="$1"
      shift
      if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
        case "${repo_command}" in
          list) printf 'Usage: asc repo list [--json]\n' ;;
          clone) printf 'Usage: asc repo clone [REPOSITORY...] [--protocol ssh|https]\n' ;;
          status) printf 'Usage: asc repo status [REPOSITORY...] [--json]\n' ;;
          sync) printf 'Usage: asc repo sync [REPOSITORY...] [--dry-run]\n' ;;
          save) printf 'Usage: asc repo save REPOSITORY [--message TEXT] [--dry-run] [--yes]\n' ;;
          *)
            asc_usage_error "unknown repo command: ${repo_command}"
            return
            ;;
        esac
        return 0
      fi
      case "${repo_command}" in
        list)
          local list_json=false
          if (($# == 1)) && [[ "$1" == --json ]]; then
            list_json=true
          elif (($# != 0)); then
            asc_usage_error "repo list accepts only --json"
            return
          fi
          asc_repo_list "${list_json}"
          ;;
        clone)
          local protocol="${ASC_CLONE_PROTOCOL}"
          local -a clone_names=()
          while (($# > 0)); do
            if [[ "$1" == --protocol ]]; then
              (($# >= 2)) || {
                asc_usage_error "--protocol requires a value"
                return
              }
              protocol="$2"
              shift 2
            elif [[ "$1" == -* ]]; then
              asc_usage_error "unknown repo clone option: $1"
              return
            else
              clone_names+=("$1")
              shift
            fi
          done
          [[ "${protocol}" == ssh || "${protocol}" == https ]] || {
            asc_usage_error "protocol must be ssh or https"
            return
          }
          asc_repository_clone "${protocol}" "${clone_names[@]}"
          ;;
        status)
          local status_json=false
          local -a status_names=()
          while (($# > 0)); do
            if [[ "$1" == --json ]]; then
              status_json=true
            elif [[ "$1" == -* ]]; then
              asc_usage_error "unknown repo status option: $1"
              return
            else
              status_names+=("$1")
            fi
            shift
          done
          asc_repository_status "${status_json}" "${status_names[@]}"
          ;;
        sync)
          local dry_run=false
          local -a sync_names=()
          while (($# > 0)); do
            if [[ "$1" == --dry-run ]]; then
              dry_run=true
            elif [[ "$1" == -* ]]; then
              asc_usage_error "unknown repo sync option: $1"
              return
            else
              sync_names+=("$1")
            fi
            shift
          done
          asc_repository_sync "${dry_run}" "${sync_names[@]}"
          ;;
        save)
          local save_repository="" save_message="" save_dry_run=false save_yes=false answer=""
          while (($# > 0)); do
            case "$1" in
              --message)
                (($# >= 2)) || {
                  asc_usage_error "--message requires a value"
                  return
                }
                save_message="$2"
                shift 2
                ;;
              --dry-run)
                save_dry_run=true
                shift
                ;;
              --yes)
                save_yes=true
                shift
                ;;
              -*)
                asc_usage_error "unknown repo save option: $1"
                return
                ;;
              *)
                [[ -z "${save_repository}" ]] || {
                  asc_usage_error "repo save takes one repository"
                  return
                }
                save_repository="$1"
                shift
                ;;
            esac
          done
          [[ -n "${save_repository}" ]] || {
            asc_usage_error "repo save requires one repository"
            return
          }
          if [[ -z "${save_message}" ]]; then
            printf -v save_message 'Updated at %(%Y-%m-%d %H:%M:%S)T' -1
          fi
          asc_repository_plan_save "${save_repository}" "${save_message}" || return 1
          if [[ "${save_dry_run}" == true ]]; then
            asc_repository_print_save_plan
            return 0
          fi
          if [[ "${save_yes}" != true ]]; then
            asc_repository_print_save_plan >&2
            printf 'Commit all listed working-tree changes and push? [y/N] ' >&2
            IFS= read -r answer || true
            answer="${answer,,}"
            if [[ "${answer}" != y && "${answer}" != yes ]]; then
              printf 'asc: repo save cancelled\n' >&2
              return 1
            fi
          fi
          asc_repository_apply_save
          ;;
        *)
          asc_usage_error "unknown repo command: ${repo_command}"
          return
          ;;
      esac
      ;;
    configure | build | test)
      local repository=""
      local preset=""
      while (($# > 0)); do
        case "$1" in
          --preset)
            (($# >= 2)) || {
              asc_usage_error "--preset requires a value"
              return
            }
            preset="$2"
            shift 2
            ;;
          -*)
            asc_usage_error "unknown ${command} option: $1"
            return
            ;;
          *)
            [[ -z "${repository}" ]] || {
              asc_usage_error "${command} takes one repository"
              return
            }
            repository="$1"
            shift
            ;;
        esac
      done
      [[ -n "${repository}" && -n "${preset}" ]] || {
        asc_usage_error "repository and --preset are required"
        return
      }
      asc_cmake_run "${command}" "${repository}" "${preset}"
      ;;
    cmake)
      asc_run_cmake_group "$@"
      ;;
    update)
      local update_check=false update_yes=false update_prefix=""
      while (($# > 0)); do
        case "$1" in
          --check)
            update_check=true
            shift
            ;;
          --yes)
            update_yes=true
            shift
            ;;
          --prefix)
            (($# >= 2)) || {
              asc_usage_error "--prefix requires a value"
              return
            }
            update_prefix="$2"
            shift 2
            ;;
          *)
            asc_usage_error "unknown update option: $1"
            return
            ;;
        esac
      done
      asc_update_run "${update_check}" "${update_yes}" "${update_prefix}"
      ;;
    completion)
      if (($# != 1)) || [[ "$1" != bash ]]; then
        asc_usage_error "only Bash completion is supported"
        return
      fi
      asc_completion_bash
      ;;
    *)
      asc_usage_error "unknown command: ${command}"
      return
      ;;
  esac
}

asc_main "$@"
