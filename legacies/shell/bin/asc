#!/usr/bin/env bash
# asc-devtools managed file

set -o errexit
set -o nounset
set -o pipefail

asc_resolve_script_path() {
  local source_path="$1"
  local directory
  local target
  while [[ -L "${source_path}" ]]; do
    directory=$(cd -P -- "$(dirname -- "${source_path}")" && pwd)
    target=$(readlink -- "${source_path}")
    if [[ "${target}" == /* ]]; then
      source_path="${target}"
    else
      source_path="${directory}/${target}"
    fi
  done
  directory=$(cd -P -- "$(dirname -- "${source_path}")" && pwd)
  printf '%s/%s\n' "${directory}" "$(basename -- "${source_path}")"
}

ASC_EXECUTABLE=$(asc_resolve_script_path "${BASH_SOURCE[0]}")
ASC_BIN_DIRECTORY=$(dirname -- "${ASC_EXECUTABLE}")
ASC_INSTALL_ROOT=$(cd -- "${ASC_BIN_DIRECTORY}/.." && pwd)
ASC_LIBRARY_DIRECTORY="${ASC_INSTALL_ROOT}/lib/asc"
if [[ ! -f "${ASC_LIBRARY_DIRECTORY}/common.sh" ]]; then
  printf 'asc: error: libraries not found under %s\n' "${ASC_LIBRARY_DIRECTORY}" >&2
  exit 1
fi

# Library location is resolved for both source and installed layouts.
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/common.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/config.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/process.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/github.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/repository.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/doctor.sh"
# shellcheck disable=SC1091
source "${ASC_LIBRARY_DIRECTORY}/cmake.sh"

asc_print_help() {
  cat <<'EOF'
Usage: asc [GLOBAL OPTIONS] COMMAND [ARGS]

Safely manage AI4SciComp repositories that are direct children of one workspace.

Commands:
  doctor                       Diagnose tools, API access, and SSH access
  workspace                    Print the resolved workspace
  repo list                    List active organization repositories
  repo clone [REPOSITORY...]   Clone missing repositories
  repo status [REPOSITORY...]  Inspect local repositories
  repo sync [REPOSITORY...]    Fast-forward clean repositories
  configure REPOSITORY         Configure with a CMake preset
  build REPOSITORY             Build with a CMake preset
  test REPOSITORY              Test with a CTest preset
  completion bash              Print Bash completion

Global options:
  --config PATH
  --organization ORGANIZATION
  --workspace PATH
  --repository-prefix PREFIX
  --clone-protocol ssh|https
  --remote NAME
  --include-dot-github | --no-include-dot-github
  -h, --help
  --version

Examples:
  asc doctor
  asc repo clone asc-cpp
  asc repo status
  asc build asc-cpp --preset dev
EOF
}

asc_print_repo_help() {
  cat <<'EOF'
Usage: asc repo {list|clone|status|sync} [REPOSITORY...]

With no repository names, clone uses organization discovery and status/sync use
managed Git worktrees that are direct children of the configured workspace.
EOF
}

asc_print_cmake_help() {
  local operation="$1"
  printf 'Usage: asc %s REPOSITORY [--preset PRESET]\n' "${operation}"
  printf 'The preset defaults to dev and must be owned by CMakePresets.json.\n'
}

asc_completion_bash() {
  local completion_path="${ASC_INSTALL_ROOT}/completions/asc.bash"
  if [[ ! -f "${completion_path}" ]]; then
    completion_path="${ASC_INSTALL_ROOT}/share/bash-completion/completions/asc"
  fi
  if [[ ! -f "${completion_path}" ]]; then
    asc_error "Bash completion file not found"
    return 1
  fi
  cat -- "${completion_path}"
}

asc_main() {
  local config_override="${ASC_OVERRIDE_UNSET}"
  local organization_override="${ASC_OVERRIDE_UNSET}"
  local workspace_override="${ASC_OVERRIDE_UNSET}"
  local prefix_override="${ASC_OVERRIDE_UNSET}"
  local include_override="${ASC_OVERRIDE_UNSET}"
  local protocol_override="${ASC_OVERRIDE_UNSET}"
  local remote_override="${ASC_OVERRIDE_UNSET}"
  local command=""
  local option
  local preset

  while (($# > 0)); do
    case "$1" in
      --config | --organization | --workspace | --repository-prefix | --clone-protocol | --remote)
        option="$1"
        if (($# < 2)); then
          asc_error "${option} requires a value"
          return 2
        fi
        case "${option}" in
          --config) config_override="$2" ;;
          --organization) organization_override="$2" ;;
          --workspace) workspace_override="$2" ;;
          --repository-prefix) prefix_override="$2" ;;
          --clone-protocol) protocol_override="$2" ;;
          --remote) remote_override="$2" ;;
        esac
        shift 2
        ;;
      --include-dot-github)
        include_override=true
        shift
        ;;
      --no-include-dot-github)
        include_override=false
        shift
        ;;
      -h | --help)
        asc_print_help
        return 0
        ;;
      --version)
        printf 'asc %s\n' "${ASC_VERSION}"
        return 0
        ;;
      --*)
        asc_error "unknown global option: $1"
        return 2
        ;;
      *)
        command="$1"
        shift
        break
        ;;
    esac
  done
  if [[ -z "${command}" ]]; then
    asc_error "a command is required; run 'asc --help'"
    return 2
  fi

  asc_config_load \
    "${config_override}" "${organization_override}" "${workspace_override}" \
    "${prefix_override}" "${include_override}" "${protocol_override}" \
    "${remote_override}" || return 1

  case "${command}" in
    doctor)
      (($# == 0)) || {
        asc_error "doctor takes no arguments"
        return 2
      }
      asc_doctor
      ;;
    workspace)
      (($# == 0)) || {
        asc_error "workspace takes no arguments"
        return 2
      }
      printf '%s\n' "${ASC_WORKSPACE}"
      ;;
    repo)
      if (($# == 0)); then
        asc_print_repo_help
        return 2
      fi
      local repo_command="$1"
      shift
      if [[ "${repo_command}" == "--help" || "${repo_command}" == "-h" ]]; then
        asc_print_repo_help
        return 0
      fi
      case "${repo_command}" in
        list)
          if (($# > 0)); then
            [[ "$1" == "--help" || "$1" == "-h" ]] && {
              printf 'Usage: asc repo list\n'
              return 0
            }
            asc_error "repo list takes no arguments"
            return 2
          fi
          asc_github_discover
          ;;
        clone | status | sync)
          if (($# > 0)) && [[ "$1" == "--help" || "$1" == "-h" ]]; then
            printf 'Usage: asc repo %s [REPOSITORY...]\n' "${repo_command}"
            return 0
          fi
          case "${repo_command}" in
            clone) asc_repository_clone "$@" ;;
            status) asc_repository_status "$@" ;;
            sync) asc_repository_sync "$@" ;;
          esac
          ;;
        *)
          asc_error "unknown repo command: ${repo_command}"
          return 2
          ;;
      esac
      ;;
    configure | build | test)
      if (($# > 0)) && [[ "$1" == "--help" || "$1" == "-h" ]]; then
        asc_print_cmake_help "${command}"
        return 0
      fi
      if (($# == 0)); then
        asc_error "${command} requires a repository"
        return 2
      fi
      local repository_name="$1"
      shift
      preset=dev
      while (($# > 0)); do
        case "$1" in
          --preset)
            if (($# < 2)); then
              asc_error "--preset requires a value"
              return 2
            fi
            preset="$2"
            shift 2
            ;;
          *)
            asc_error "unknown ${command} option: $1"
            return 2
            ;;
        esac
      done
      asc_cmake_run "${command}" "${repository_name}" "${preset}"
      ;;
    completion)
      if (($# != 1)) || [[ "$1" != "bash" ]]; then
        asc_error "usage: asc completion bash"
        return 2
      fi
      asc_completion_bash
      ;;
    *)
      asc_error "unknown command: ${command}"
      return 2
      ;;
  esac
}

asc_main "$@"
